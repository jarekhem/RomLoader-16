# Bochs configuration for RomLoader-16 (COM3 0x03E8 TCP server on localhost:4444)
plugin_ctrl: voodoo=false, unmapped=true, biosdev=true, speaker=true, extfpuirq=true, parallel=true, serial=true, busmouse=false, e1000=false, es1370=false, gameport=true, iodebug=true, ne2k=false, sb16=false, usb_uhci=false, usb_ohci=false, usb_ehci=false, usb_xhci=false
config_interface: win32config
display_library: win32
memory: guest=32, host=32, block_size=128
romimage: file="RomLoader-16.bin", address=0xffff8000
vgaromimage: file="$BXSHARE/VGABIOS-lgpl-latest.bin"
boot: floppy
floppy_bootsig_check: disabled=0
floppya: type=1_44
ata0: enabled=false
ata1: enabled=false
ata2: enabled=false
ata3: enabled=false
optromimage1: file=none
optromimage2: file=none
optromimage3: file=none
optromimage4: file=none
optramimage1: file=none
optramimage2: file=none
optramimage3: file=none
optramimage4: file=none
pci: enabled=0
vga: extension=vbe, update_freq=10, realtime=1, ddc=builtin
cpu: count=1, ips=4000000, model=i386, reset_on_triple_fault=1, cpuid_limit_winnt=0, ignore_bad_msrs=1, mwait_is_nop=0
print_timestamps: enabled=0
debugger_log: -
magic_break: enabled=1 0x8
port_e9_hack: enabled=false, all_rings=false
private_colormap: enabled=0
clock: sync=none, time0=local, rtc_sync=0
log: -
logprefix: %t%e%d
debug: action=ignore
info: action=report
error: action=report
panic: action=ask
keyboard: type=at, serial_delay=150, paste_delay=100000, user_shortcut=none
mouse: type=none, enabled=false, toggle=ctrl+mbutton
sound: waveoutdrv=win, waveout=none, waveindrv=win, wavein=none, midioutdrv=win, midiout=none
speaker: enabled=true, mode=sound, volume=15
parport1: enabled=false
parport2: enabled=false
com1: enabled=false
com2: enabled=false
com3: enabled=true, mode=socket-server, dev=localhost:4444
com4: enabled=false
